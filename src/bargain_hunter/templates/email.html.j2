<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bargain Hunter Digest</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; padding: 0; background: #f5f5f5; color: #111; }
  .wrap { max-width: 600px; margin: 24px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .header { background: #ff6600; padding: 20px 24px; }
  .header h1 { margin: 0; color: #fff; font-size: 20px; }
  .header small { color: rgba(255,255,255,.8); font-size: 13px; }
  .deal { padding: 20px 24px; border-bottom: 1px solid #eee; }
  .deal:last-child { border-bottom: none; }
  .deal h2 { margin: 0 0 6px; font-size: 16px; }
  .deal h2 a { color: #111; text-decoration: none; }
  .deal h2 a:hover { text-decoration: underline; }
  .meta { display: flex; flex-wrap: wrap; gap: 10px; margin: 8px 0; font-size: 13px; color: #555; }
  .badge { background: #f0f0f0; border-radius: 4px; padding: 2px 8px; }
  .badge.price { background: #e8f5e9; color: #2e7d32; font-weight: 600; }
  .badge.hot { background: #fff3e0; color: #e65100; }
  .badge.watch { background: #e3f2fd; color: #1565c0; }
  .badge.discount { background: #fce4ec; color: #c62828; font-weight: 600; }
  .badge.cashback { background: #e0f2f1; color: #00695c; font-weight: 600; }
  .badge.pricelow { background: #e8f5e9; color: #1b5e20; font-weight: 600; }
  .badge.pricehigh { background: #fff8e1; color: #ef6c00; font-weight: 600; }
  .badge.level { background: #ede7f6; color: #4527a0; font-weight: 600; text-transform: uppercase; }
  .badge.level-top { background: #4527a0; color: #fff; }
  .reason { font-size: 12px; color: #888; margin-top: 6px; }
  .links { margin-top: 10px; font-size: 13px; }
  .links a { color: #ff6600; text-decoration: none; margin-right: 12px; }
  .links a:hover { text-decoration: underline; }
  .cta { padding: 18px 24px; text-align: center; background: #fff; border-top: 1px solid #eee; }
  .cta a { display: inline-block; background: #ff6600; color: #fff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 11px 22px; border-radius: 6px; }
  .capnote { padding: 12px 24px; font-size: 13px; color: #8a6d3b; background: #fcf8e3; border-top: 1px solid #faebcc; }
  .capnote a { color: #8a6d3b; }
  .footer { padding: 16px 24px; font-size: 12px; color: #aaa; background: #fafafa; }
  .footer a { color: #888; text-decoration: none; }
  .footer a:hover { text-decoration: underline; }
  .expiry { font-size: 12px; color: #c62828; }
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <h1><a href="{{ site_url }}" style="color:#fff;text-decoration:none;">Bargain Hunter</a></h1>
    <small>{{ deals|length }} deal{{ 's' if deals|length != 1 else '' }} for {{ subscriber.name }}</small>
  </div>

  {% for item in deals %}
  {% set deal = item.deal %}
  <div class="deal">
    <h2><a href="{{ item.affiliate_deal_url }}">{{ deal.title }}</a></h2>
    <div class="meta">
      {% if deal.price is not none and deal.price_confidence == 'high' %}
      <span class="badge price">{{ "US$" if deal.currency != "AUD" else "$" }}{{ "%.2f"|format(deal.price) }}</span>
      {% endif %}
      {% if deal.discount_percent is not none %}
      <span class="badge discount">{{ "%.0f"|format(deal.discount_percent) }}% off</span>
      {% endif %}
      {% if deal.cashback_percent %}
      <span class="badge cashback" title="Stack cashback via {{ deal.cashback_provider }}">+ up to {{ "%g"|format(deal.cashback_percent) }}% cashback</span>
      {% endif %}
      {% if deal.price_rank == 'lowest' %}
      <span class="badge pricelow">💰 Lowest in {{ deal.price_history_days }}d</span>
      {% elif deal.price_rank == 'low' %}
      <span class="badge pricelow">Near {{ deal.price_history_days }}d low</span>
      {% elif deal.price_rank == 'high' %}
      <span class="badge pricehigh">⚠ Above typical price</span>
      {% endif %}
      <span class="badge {{ item.track }}">{{ item.track|upper }}</span>
      {% if item.level %}
      <span class="badge level{{ ' level-top' if item.level == 'top' else '' }}">{{ item.level }}</span>
      {% endif %}
      <span class="badge">▲ {{ deal.votes_pos }}</span>
      {% if deal.comment_count %}
      <span class="badge">💬 {{ deal.comment_count }}</span>
      {% endif %}
    </div>
    {% if item.reason %}
    <div class="reason">{{ item.reason }}</div>
    {% endif %}
    {% if deal.expiry %}
    <div class="expiry">Expires {{ deal.expiry.strftime('%d %b %Y %H:%M AEST') }}</div>
    {% endif %}
    <div class="links">
      <a href="{{ item.affiliate_deal_url }}">{{ source_labels.get(deal.source, deal.source|title) }} ↗</a>
      {% if item.affiliate_merchant_url %}
      <a href="{{ item.affiliate_merchant_url }}">Go to deal ↗</a>
      {% endif %}
      {% if item.feedback_up_url %}
      <a href="{{ item.feedback_up_url }}">👍 Good</a>
      <a href="{{ item.feedback_down_url }}">👎 Meh</a>
      {% endif %}
    </div>
  </div>
  {% endfor %}

  <div class="cta">
    <a href="{{ site_url }}/deals">🔥 Browse all live deals on the web →</a>
  </div>

  {% if cap_suppressed and cap_suppressed > 0 %}
  <div class="capnote">
    {{ cap_suppressed }} more deal{{ 's' if cap_suppressed != 1 else '' }} matched today but
    {{ 'were' if cap_suppressed != 1 else 'was' }} held back by your daily cap &mdash;
    <a href="{{ site_url }}/portal">raise it in your portal settings</a>.
  </div>
  {% endif %}

  <div class="footer">
    Sent {{ sent_at }}.
    &nbsp;·&nbsp;<a href="{{ site_url }}">Visit website</a>
    {% if unsubscribe_url %}
    &nbsp;·&nbsp;<a href="{{ unsubscribe_url }}">Unsubscribe</a>
    {% endif %}
  </div>
</div>
</body>
</html>
