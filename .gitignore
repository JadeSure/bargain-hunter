# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Secrets / local env
.env
.env.local

# OS
.DS_Store

# Local tooling state
.omc/
.claude/
.kiro/

# Local build artifacts — never committed; safe to delete to reclaim disk.
# (JS deps ~1.1G, Terraform providers ~0.9G — regenerated by npm i / terraform init.)
node_modules/
.terraform/
*.tfstate
*.tfstate.backup

# Note: data/ is intentionally tracked (non-personal deal history powers velocity).
# Exception: the quiet-hours queue holds subscriber emails (PII) — never commit it.
# It persists between Actions runs via the hot cache only (see hunt.yml).
data/queued_notifications.json
